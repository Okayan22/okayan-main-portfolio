---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-container">
		<p class="copyright">
			&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
		</p>

		<div class="social-links">
			<!-- Zenn -->
			<a href="https://zenn.dev/okayan22" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Follow Okayan22 on Zenn</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
					<path
						fill="currentColor"
						d="M1.3 23.8h5c.3 0 .5-.1.6-.4L20 .9c.2-.3 0-.6-.4-.6h-4.7c-.2 0-.4.1-.6.3L.1 23.4c-.1.2 0 .4.2.4zm16.1-.4 6.5-10.4c.2-.3 0-.7-.4-.7h-4.7c-.2 0-.4.1-.4.2l-6.7 10.6c-.2.3 0 .6.4.6h4.8c.2 0 .5-.1.6-.4z"
					/>
				</svg>
				<span class="link-label">Zenn</span>
			</a>

			<!-- X / Twitter -->
			<a href="https://x.com/okayan_22" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Follow @okayan_22 on X</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
				<span class="link-label">X</span>
			</a>

			<!-- GitHub -->
			<a href="https://github.com/Okayan22" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Go to Okayan22's GitHub profile</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
				</svg>
				<span class="link-label">GitHub</span>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: auto;
		padding: 2rem 1.5rem;
		background: #070b16;
		border-top: 1px solid rgba(163, 192, 232, 0.14);
	}
	.footer-container {
		max-width: 1120px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.2rem;
	}
	.copyright {
		margin: 0;
		color: #9aa9c2;
		font-size: 0.85rem;
		line-height: 1;
		letter-spacing: 0.05em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.social-links a {
		color: #9aa9c2;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		line-height: 1;
		text-decoration: none;
		transition: color 0.2s, transform 0.2s;
	}
	.social-links a svg {
		display: block; /* SVGの余計な下部余白を削除 */
		flex-shrink: 0;
	}
	.social-links a:hover {
		color: #72f1ff;
		transform: translateY(-2px);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}

	@media (min-width: 640px) {
		.footer-container {
			flex-direction: row;
			justify-content: space-between;
			align-items: center; /* PC横並び時の上下中央揃えを強制 */
		}
	}
</style>
