
---
import HeaderLink from './HeaderLink.astro';

const isJournal = Astro.url.pathname.startsWith('/journal');
const homePath = Astro.url.pathname === '/' ? '' : '/';
---

<header>
	<nav>
		<h2><a href="/" aria-label="Okayan’s Portfolio ホーム"><img class="brand-logo" src="/portfolio-logo.png" alt="Okayan’s Portfolio" /></a></h2>

		<div class:list={["internal-links", { "journal-nav": isJournal }]}>
			{isJournal ? (
				<>
					<HeaderLink href="/">Home</HeaderLink>
					<span class="nav-divider" aria-hidden="true"></span>
					<HeaderLink href="/journal" class="journal-link">Journal</HeaderLink>
				</>
			) : (
				<>
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href={`${homePath}#article`}>Articles</HeaderLink>
					<HeaderLink href={`${homePath}#products`}>Products</HeaderLink>
					<HeaderLink href={`${homePath}#qualifications`}>Qualifications</HeaderLink>
					<HeaderLink href={`${homePath}#skills`}>Tech stack</HeaderLink>
					<span class="nav-divider" aria-hidden="true"></span>
					<HeaderLink href="/journal" class="journal-link">Journal <span aria-hidden="true">↗</span></HeaderLink>
				</>
			)}
		</div>

		<div class="social-links">
			<!-- Zenn -->
			<a
				href="https://zenn.dev/okayan22"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Zenn"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M1.3 23.8h5c.3 0 .5-.1.6-.4L20 .9c.2-.3 0-.6-.4-.6h-4.7c-.2 0-.4.1-.6.3L.1 23.4c-.1.2 0 .4.2.4zm16.1-.4 6.5-10.4c.2-.3 0-.7-.4-.7h-4.7c-.2 0-.4.1-.4.2l-6.7 10.6c-.2.3 0 .6.4.6h4.8c.2 0 .5-.1.6-.4z"
					/>
				</svg>
			</a>

			<!-- X / Twitter -->
			<a
				href="https://x.com/okayan_22"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="X (Twitter)"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>

			<!-- GitHub -->
			<a
				href="https://github.com/Okayan22"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.12 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	/* ヘッダー */
	header {
		position: sticky;
		top: 0;
		z-index: 1000;

		margin: 0;
		padding: 0 1.5rem;

		background: rgba(7, 11, 22, 0.95);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);

		border-bottom: 1px solid rgba(163, 192, 232, 0.14);
	}

	/* サイトタイトル */
	h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 800;
	}

	h2 a {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.brand-logo {
		display: block;
		width: 180px;
		max-height: 60px;
		object-fit: contain;
		mix-blend-mode: screen;
		transition: filter 0.2s;
	}

	h2 a:hover .brand-logo {
		filter: drop-shadow(0 0 8px rgba(114, 241, 255, 0.45));
	}

	/* ナビゲーション */
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;

		height: 70px;
		max-width: 1120px;
		margin: 0 auto;
	}

	/* 内部リンク */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-divider {
		width: 1px;
		height: 22px;
		background: rgba(163, 192, 232, 0.28);
	}

	.journal-link span {
		margin-left: 0.2rem;
		font-size: 0.75em;
	}

	.journal-nav .nav-divider {
		margin: 0 0.1rem;
	}

	.internal-links a {
		padding: 0.5rem 0;

		color: #9aa9c2;
		border-bottom: 2px solid transparent;

		text-decoration: none;
		font-size: 0.9rem;

		transition:
			color 0.2s,
			border-color 0.2s;
	}

	.internal-links a:hover,
	.internal-links a.active {
		color: #72f1ff;
		text-decoration: none;
		border-bottom-color: #72f1ff;
	}

	/* SNSリンク */
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.2rem;
	}

	.social-links a {
		display: flex;
		align-items: center;

		color: #9aa9c2;

		transition:
			color 0.2s,
			transform 0.2s;
	}

	.social-links a:hover {
		color: #72f1ff;
		transform: translateY(-2px);
	}

	/* スマートフォン対応 */
	@media (max-width: 720px) {
		header {
			padding: 0 0.8rem;
		}

		nav {
			height: auto;
			min-height: 60px;
			padding: 0.65rem 0;
			flex-direction: column;
			justify-content: center;
			gap: 0.45rem;
		}

		h2 {
			align-self: center;
		}

		.internal-links {
			max-width: 100%;
			flex-wrap: wrap;
			justify-content: center;
			column-gap: 0.85rem;
			row-gap: 0.1rem;
		}

		.journal-nav {
			margin-left: 0;
		}

		.nav-divider {
			height: 16px;
		}

		.internal-links a {
			padding: 0.25rem 0;
			font-size: 0.75rem;
		}

		.social-links {
			display: none;
		}
	}

	/* ページ内スクロール設定 */
	:global(html) {
		scroll-behavior: smooth;
	}

	/* 固定ヘッダーによる見出しの隠れ防止 */
	:global(section[id]) {
		scroll-margin-top: 90px;
	}

	/* 動きを減らす設定を優先するユーザーへの配慮 */
	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}
	}
</style>
