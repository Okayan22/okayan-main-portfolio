---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`${post.data.title} | ${SITE_TITLE}`} description={post.data.description} />
    <meta name="theme-color" content="#151923" />
  </head>
  <body>
    <Header />
    <a class="back-link" href="/journal" aria-label="Journal一覧へ戻る">
      <svg class="back-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.7 13.5c-1.4-.8-1.4-2.2 0-3l10-5.8c1.6-.9 3.6.2 3.6 2v10.6c0 1.8-2 2.9-3.6 2l-10-5.8Z" />
      </svg>
      <span class="back-label">BACK</span>
    </a>
    <main class="article-shell">
      <article>
        <header class="article-header">
          <time datetime={post.data.pubDate ? new Date(post.data.pubDate).toISOString() : ''}>
            {post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('ja-JP') : ''}
          </time>
          <h1>{post.data.title}</h1>
          <p class="description">{post.data.description}</p>
        </header>

        <div class="markdown-body">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(html) { min-height: 100%; background-color: #151923; }
  :global(body) {
    min-height: 100vh;
    margin: 0;
    background-color: #151923;
    background-image:
      radial-gradient(ellipse 75% 420px at 12% 8%, rgba(35, 210, 255, .14), transparent 72%),
      radial-gradient(ellipse 70% 520px at 92% 48%, rgba(85, 75, 255, .12), transparent 72%),
      radial-gradient(ellipse 80% 520px at 18% 88%, rgba(35, 210, 255, .11), transparent 72%);
    background-repeat: no-repeat;
    color: #e0e0e0;
    font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', sans-serif;
  }
  .back-link {
    position: absolute;
    top: 92px;
    left: max(16px, calc((100vw - 1190px) / 2));
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 46px;
    padding: 0 17px 0 13px;
    color: #72f1ff;
    background: linear-gradient(135deg, rgba(34, 211, 238, .2), rgba(34, 38, 49, .92) 72%);
    border: 1px solid rgba(114, 241, 255, .72);
    border-radius: 12px;
    box-shadow: 0 0 22px rgba(35, 210, 255, .2), inset 0 0 16px rgba(35, 210, 255, .08);
    text-decoration: none;
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .18em;
    transition: color .2s, border-color .2s, background .2s, transform .2s, box-shadow .2s;
  }
  .back-link:hover {
    color: #eaffff;
    background: linear-gradient(135deg, rgba(34, 211, 238, .38), rgba(34, 48, 60, .98) 72%);
    border-color: #a8f8ff;
    box-shadow: 0 0 32px rgba(35, 210, 255, .38), inset 0 0 20px rgba(35, 210, 255, .12);
    transform: translateX(-3px);
  }
  .back-icon { display: block; width: 19px; height: 19px; flex: 0 0 19px; fill: #72f1ff; filter: drop-shadow(0 0 7px rgba(114, 241, 255, .8)); }
  .back-label { text-shadow: 0 0 12px rgba(114, 241, 255, .45); }
  .article-shell { max-width: 750px; margin: 0 auto; padding: 100px 20px 40px; }
  .article-header { border-bottom: 1px solid #333; padding-bottom: 24px; margin-bottom: 32px; }
  .article-header time { color: #72f1ff; font-size: 0.9rem; }
  .article-header h1 { color: #fff; font-size: 2rem; margin: 12px 0; line-height: 1.3; }
  .description { color: #aaa; font-size: 1.05rem; line-height: 1.6; }

  .markdown-body { color: #e0e0e0; line-height: 1.8; font-size: 1rem; }
  .markdown-body :global(h2) { color: #fff; font-size: 1.5rem; margin-top: 2em; border-bottom: 1px solid #333; padding-bottom: 8px; }
  .markdown-body :global(h3) { color: #72f1ff; font-size: 1.2rem; margin-top: 1.6em; }
  .markdown-body :global(p) { margin: 1em 0; }
  .markdown-body :global(a) { color: #72f1ff; }
  .markdown-body :global(ol), .markdown-body :global(ul) { padding-left: 1.5em; }
  .markdown-body :global(li) { margin: .4em 0; }
  .markdown-body :global(hr) { border: 0; border-top: 1px solid #333; margin: 2em 0; }
  .markdown-body :global(strong) { color: #fff; }
  .markdown-body :global(blockquote) { border-left: 3px solid #72f1ff; padding-left: 16px; color: #888; font-style: italic; margin: 1.5em 0; }
  .markdown-body :global(code) { background: rgba(114, 241, 255, 0.1); color: #72f1ff; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
</style>
