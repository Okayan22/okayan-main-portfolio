---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

// 1. Markdown記事を全件取得
const allPosts = await getCollection('journal');

// 2. 日付順にソート（新しい順）
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = [
  {
    id: 'daily-log',
    number: '01',
    title: 'Daily Log',
    subtitle: '日々の活動の記録',
    description: '挑戦したことや印象に残ったことを、自分の言葉で振り返ります。',
  },
  {
    id: 'monthly-review',
    number: '02',
    title: 'Monthly Review',
    subtitle: '月ごとの振り返り',
    description: 'できるようになったこと、気づき、次に取り組みたいことをまとめます。',
  },
];
---


<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`Journal | ${SITE_TITLE}`} description="技術学習や日々の活動、月ごとの振り返りを記録するJournalです。" />
    <meta name="theme-color" content="#151923" />
  </head>
  <body>
    <Header />
    <main class="journal-shell">
      <header class="journal-hero">
        <p class="eyebrow">MY LEARNING JOURNEY</p>
        <h1>Journal<span>.</span></h1>
        <p class="intro">学びや挑戦の足跡を、少しずつ記録していきます。</p>
        <p class="hero-note">書けるときに、書ける分だけ。ここには公開できる記録を残します。</p>
      </header>

      <nav class="journal-index" aria-label="Journal categories">
        {categories.map((category) => (
          <a href={`#${category.id}`}><span>{category.number}</span>{category.title}<span class="index-arrow" aria-hidden="true">↘</span></a>
        ))}
      </nav>

            <div class="category-list">
        {categories.map((category) => {
          // 記事を置いたフォルダ名からカテゴリーを判定
          const categoryPosts = sortedPosts.filter(
            (post) => post.id.startsWith(`${category.id}/`)
          );

          return (
            <section class="category" id={category.id} aria-labelledby={`${category.id}-title`}>
              <div class="category-heading">
                <span class="category-number">{category.number}</span>
                <div>
                  <p class="category-subtitle">{category.subtitle}</p>
                  <h2 id={`${category.id}-title`}>{category.title}</h2>
                </div>
              </div>
              <p class="category-description">{category.description}</p>

              {categoryPosts.length > 0 ? (
                <div class="post-list">
                  {categoryPosts.map((post) => (
                    <a class="post-card-link" href={`/journal/${post.slug}`}>
                      <article class="post-card">
                        <time datetime={new Date(post.data.pubDate).toISOString()}>
                          {new Date(post.data.pubDate).toLocaleDateString('ja-JP')}
                        </time>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                        {post.data.tags && (
                          <div class="tags">
                            {post.data.tags.map((tag) => (
                              <span class="tag">#{tag}</span>
                            ))}
                          </div>
                        )}
                      </article>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="empty-state">
                  <span class="empty-mark" aria-hidden="true">✳</span>
                  <div>
                    <h3>これから記録していきます</h3>
                    <p>公開できる記事が追加されると、ここに表示されます。</p>
                  </div>
                  <span class="empty-label">NO ENTRIES YET</span>
                </div>
              )}
            </section>
          );
        })}
      </div>

    </main>
    <Footer />
  </body>
</html>

<style>
    /* 記事カード用スタイル */
  .post-list { display: grid; gap: 16px; margin-top: 15px; }
  .post-card-link { display: block; color: inherit; text-decoration: none; }
  .post-card { padding: 20px; background-color: rgba(34, 38, 49, .92); border: 1px solid #333; border-radius: 10px; transition: border-color .2s, transform .2s; }
  .post-card:hover { border-color: #72f1ff; transform: translateY(-2px); }
  .post-card time { font-size: .8rem; color: #72f1ff; font-variant-numeric: tabular-nums; }
  .post-card h3 { margin: 8px 0; color: #fff; font-size: 1.1rem; transition: color .2s; }
  .post-card-link:hover .post-card h3 { color: #72f1ff; }
  .post-card-link:focus-visible { outline: 2px solid #72f1ff; outline-offset: 4px; border-radius: 10px; }
  .post-card p { margin: 0 0 12px; color: #aaa; font-size: .88rem; line-height: 1.6; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag { font-size: .75rem; color: #72f1ff; background: rgba(114, 241, 255, .1); padding: 3px 8px; border-radius: 4px; }

  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background-color: #151923;
    background-image:
      radial-gradient(ellipse 75% 420px at 12% 8%, rgba(35, 210, 255, .14), transparent 72%),
      radial-gradient(ellipse 70% 520px at 92% 48%, rgba(85, 75, 255, .12), transparent 72%),
      radial-gradient(ellipse 80% 520px at 18% 88%, rgba(35, 210, 255, .11), transparent 72%);
    background-repeat: no-repeat;
    color: #e0e0e0;
    font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', sans-serif;
  }
  .journal-shell { max-width: 850px; margin: 0 auto; padding: 40px 20px; }
  .journal-hero { padding: 20px 0 28px; border-bottom: 1px solid #333; }
  .eyebrow { margin: 0 0 12px; color: #72f1ff; font-size: .8rem; font-weight: 700; letter-spacing: .12em; }
  h1 { margin: 0; color: #fff; font-size: 2.2rem; letter-spacing: 2px; line-height: 1.2; }
  h1 span { color: #72f1ff; text-shadow: 0 0 18px rgba(114, 241, 255, .45); }
  .intro { margin: 18px 0 8px; color: #f1f1f1; font-size: 1.05rem; font-weight: 700; line-height: 1.8; }
  .hero-note { margin: 0; color: #aaa; font-size: .9rem; line-height: 1.8; }
  .journal-index { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; padding: 24px 0 0; }
  .journal-index a { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 16px; color: #ddd; background-color: rgba(34, 38, 49, .92); border: 1px solid #333; border-radius: 8px; text-decoration: none; font-size: .9rem; transition: border-color .2s, transform .2s; }
  .journal-index a:hover { border-color: #72f1ff; transform: translateY(-2px); }
  .journal-index a span:first-child, .category-number { color: #72f1ff; font-size: .8rem; font-variant-numeric: tabular-nums; }
  .index-arrow { margin-left: auto; color: #888; }
  .category-list { padding-top: 20px; }
  .category { padding: 35px 0; border-bottom: 1px solid #333; scroll-margin-top: 90px; }
  .category-heading { display: flex; align-items: flex-start; gap: 15px; }
  .category-number { padding-top: 7px; }
  .category-subtitle { margin: 0 0 7px; color: #777; font-size: .85rem; }
  h2 { margin: 0; color: #fff; font-size: 1.5rem; letter-spacing: 1px; }
  .category-description { margin: 14px 0 20px; color: #aaa; font-size: .9rem; line-height: 1.7; }
  .empty-state { display: flex; align-items: center; gap: 15px; padding: 22px; background-color: rgba(34, 38, 49, .92); border: 1px solid #333; border-radius: 10px; }
  .empty-mark { display: grid; place-items: center; width: 38px; height: 38px; flex: 0 0 38px; color: #72f1ff; background: rgba(114, 241, 255, .1); border-radius: 50%; font-size: 1.1rem; }
  .empty-state h3 { margin: 0 0 7px; color: #fff; font-size: .95rem; }
  .empty-state p { margin: 0; color: #aaa; font-size: .85rem; line-height: 1.7; }
  .empty-label { margin-left: auto; color: #777; font-size: .65rem; letter-spacing: .1em; white-space: nowrap; }
  code { color: #b8f7ff; font-size: .9em; overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    .journal-shell { padding: 40px 20px; }
    .journal-index { grid-template-columns: 1fr; gap: 10px; }
    .journal-index a { padding: 14px 16px; }
    .category { padding: 29px 0; }
    .empty-state { align-items: flex-start; padding: 17px; }
    .empty-label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
