
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { articles } from '../data/articles';
import { products } from '../data/products';
import { qualifications } from '../data/qualifications';
const acquiredQualifications = qualifications.filter((qualification) => qualification.status === 'acquired');
const studyingQualifications = qualifications.filter((qualification) => qualification.status === 'studying');
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			html {
    			scroll-behavior: smooth;
}
			/* 全体レイアウト */
			body {
				background-color: #151923;
				background-image:
					radial-gradient(ellipse 75% 420px at 12% 8%, rgba(35, 210, 255, .14), transparent 72%),
					radial-gradient(ellipse 70% 520px at 92% 48%, rgba(85, 75, 255, .12), transparent 72%),
					radial-gradient(ellipse 80% 520px at 18% 88%, rgba(35, 210, 255, .11), transparent 72%);
				background-repeat: no-repeat;
				color: #e0e0e0;
				margin: 0;
				font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', sans-serif;
			}

			.container {
				max-width: 850px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			/* プロフィール部分 */
			.profile-section {
				display: flex;
				gap: 40px;
				align-items: flex-start;
				margin-top: 20px;
				padding-bottom: 30px;
				border-bottom: 1px solid rgba(163, 192, 232, .18);
			}

			.avatar-img {
				width: 160px;
				height: 160px;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}

			.profile-content {
				flex: 1;
			}

			.name-ja {
				font-size: 2.2rem;
				font-weight: bold;
				margin: 0 0 8px 0;
				color: #ffffff;
				letter-spacing: 2px;
			}

			.name-en {
				font-size: 1.1rem;
				color: #a0a0a0;
				margin: 0 0 24px 0;
			}

			.catchphrase {
				font-size: 1.05rem;
				font-weight: bold;
				margin-bottom: 20px;
				color: #ffffff;
			}

			.bio-text {
				line-height: 1.8;
				color: #cccccc;
				margin-bottom: 16px;
				font-size: 0.95rem;
			}

			.contact-row {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 20px;
			}

			.contact-button {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				padding: 7px 16px;
				color: #151923;
				background: #72f1ff;
				border: 1px solid #72f1ff;
				border-radius: 7px;
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				transition: background-color .2s, box-shadow .2s, transform .2s;
			}

			.contact-button:hover {
				background: #a1f7ff;
				box-shadow: 0 0 20px rgba(114, 241, 255, .25);
				transform: translateY(-2px);
			}

			.contact-email {
				color: #cccccc;
				font-size: 0.9rem;
				user-select: text;
			}

			/* 各セクション */
			.section {
				margin-top: 65px;
			}

			#article {
				margin-top: 35px;
			}

			.section-title {
				font-size: 1.5rem;
				color: #ffffff;
				text-shadow: 0 0 20px rgba(114, 241, 255, .12);
				margin-bottom: 8px;
				letter-spacing: 1px;
			}

			.section-subtitle {
				color: #777777;
				font-size: 0.85rem;
				margin-bottom: 25px;
			}

			/* プロダクト */
			.product-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 20px;
			}

			.product-card {
				position: relative;
				background-color: rgba(34, 38, 49, .92);
				border: 1px solid #333333;
				border-radius: 10px;
				padding: 22px;
				transition: border-color 0.2s, transform 0.2s;
			}

			.product-card:hover {
				border-color: #72f1ff;
				transform: translateY(-3px);
			}

			.product-name {
				font-size: 1.05rem;
				color: #ffffff;
				font-weight: bold;
				margin: 0 0 12px 0;
			}

			.product-description {
				color: #aaaaaa;
				font-size: 0.9rem;
				line-height: 1.7;
				margin-bottom: 16px;
			}

			.tech-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 7px;
			}

			.tech-tag {
				background-color: rgba(48, 58, 72, .88);
				color: #bbbbbb;
				padding: 5px 10px;
				border-radius: 5px;
				font-size: 0.75rem;
			}

			.product-link {
				display: inline-block;
				color: #aaaaaa;
				font-size: 0.85rem;
				margin-top: 18px;
				text-decoration: underline;
				transition: color 0.2s;
			}

			.product-link::after {
				content: '';
				position: absolute;
				inset: 0;
			}

			.product-card:focus-within {
				outline: 2px solid #72f1ff;
				outline-offset: 3px;
			}

			.product-link:hover {
				color: #72f1ff;
			}

			/* 資格 */
			.qualification-list {
				border-top: 1px solid #333333;
			}

			.qualification-item {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 15px;
				padding: 18px 5px;
				border-bottom: 1px solid #333333;
			}

			.qualification-name {
				color: #dddddd;
				font-size: 0.95rem;
				font-weight: bold;
			}

			.qualification-date {
				color: #888888;
				font-size: 0.85rem;
				white-space: nowrap;
			}

			/* 技術スキル */
			.skill-groups {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 15px;
			}

			.skill-group {
				background-color: rgba(34, 38, 49, .92);
				border: 1px solid #333333;
				border-radius: 8px;
				padding: 20px;
			}

			.skill-category {
				color: #ffffff;
				font-size: 0.95rem;
				font-weight: bold;
				margin-bottom: 12px;
			}

			/* スマホ対応 */
			@media (max-width: 640px) {
				.profile-section {
					flex-direction: column;
					align-items: center;
					text-align: center;
				}

				.avatar-img {
					width: 140px;
					height: 140px;
				}

				.product-grid,
				.skill-groups {
					grid-template-columns: 1fr;
				}

				.qualification-item {
					align-items: flex-start;
					flex-direction: column;
					gap: 6px;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="container">

			<!-- プロフィール -->
			<div class="profile-section">
				<img src="/avatar.png" alt="Okayan" class="avatar-img" />

				<div class="profile-content">
					<h1 class="name-ja">Okayan</h1>
					<p class="name-en">職業：高専生 / 得意分野：ネットワーク / 趣味：バドミントン</p>

					<p class="catchphrase">
						Linux・Docker・Network が得意なフルスタック志向の高専生エンジニア
					</p>

					<p class="bio-text">
						LinuxをベースにDockerやAnsibleを活用したインフラ構築やシステム開発に取り組んでいます。<br />
						高専ではPythonプログラミングからUNIXリテラシーまで幅広い分野を学んでおり、AI技術が急速に発展する今日において、単なるコーディング力にとどまらず、
						<u><b>設計・開発プロセス、試行錯誤（トライ＆エラー）を通じた問題解決、そしてリファクタリング力</b></u>
						に重点を置いて日々スキルを磨いています。
					</p>

					<p class="bio-text">
						『できない』で終わらせず『できる』まで磨き上げる、粘り強い試行錯誤が私の強みです。
					</p>

					<div class="contact-row">
						<a class="contact-button" href="mailto:s.okabe@gmail.com">
							お問い合わせ <span aria-hidden="true">↗</span>
						</a>
						<span class="contact-email">   Mail : s.okabe@gmail.com</span>
					</div>
				</div>
			</div>


<!-- Article -->
<section class="section" id="article">
	<h2 class="section-title">Articles</h2>
	<p class="section-subtitle">Zennに投稿した技術記事</p>

	<div class="product-grid">
		{articles.map((article, index) => (
			<div class:list={["product-card", { "tile-hidden": index >= 4 }]}>
				<h3 class="product-name">{article.title}</h3>
				<p class="product-description">{article.description}</p>
				<div class="tech-tags">
					{article.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
				</div>
				<a href={article.url} class="product-link" target="_blank" rel="noopener noreferrer">
					Read Article →
				</a>
			</div>
		))}
	</div>
	{articles.length >= 5 && (
		<button class="show-more-button" type="button" aria-expanded="false">
			<span>もっと見る</span><span class="show-more-arrow" aria-hidden="true">▼</span>
		</button>
	)}
</section>


<!-- Products -->
<section class="section" id="products">
	<h2 class="section-title">Products</h2>
	<p class="section-subtitle">制作したプロダクト</p>

	<div class="product-grid">
		{products.map((product, index) => (
			<div class:list={["product-card", { "tile-hidden": index >= 4 }]}>
				<h3 class="product-name">{product.name}</h3>
				<p class="product-description">{product.description}</p>
				<div class="tech-tags">
					{product.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
				</div>
				<a href={product.url} class="product-link" target="_blank" rel="noopener noreferrer">
					View on GitHub →
				</a>
			</div>
		))}
	</div>
	{products.length >= 5 && (
		<button class="show-more-button" type="button" aria-expanded="false">
			<span>もっと見る</span><span class="show-more-arrow" aria-hidden="true">▼</span>
		</button>
	)}
</section>



<!-- 資格 -->
<section class="section" id="qualifications">
	<h2 class="section-title">Qualifications</h2>
	<p class="section-subtitle">取得資格・学習中の資格</p>

	{acquiredQualifications.length > 0 && (
	<div class="qualification-group">
		<h3 class="skill-category">Acquired</h3>

		<div class="qualification-list">
			{acquiredQualifications.map((qualification) => (
				<div class:list={["qualification-item", { "tile-hidden": qualifications.indexOf(qualification) >= 4 }]}>
					<span class="qualification-name">{qualification.name}</span>
					<span class="qualification-date">{qualification.date}</span>
				</div>
			))}
		</div>
	</div>
	)}

	<!-- 勉強中 -->
	<div class="qualification-group" style="margin-top: 35px;">
		<h3 class="skill-category">Currently Studying</h3>

		<div class="qualification-list">
			{studyingQualifications.map((qualification) => (
				<div class:list={["qualification-item", { "tile-hidden": qualifications.indexOf(qualification) >= 4 }]}>
					<span class="qualification-name">{qualification.name}</span>
					<span class="qualification-date">{qualification.date}</span>
				</div>
			))}
		</div>
	</div>
	{qualifications.length >= 5 && (
		<button class="show-more-button" type="button" aria-expanded="false">
			<span>もっと見る</span><span class="show-more-arrow" aria-hidden="true">▼</span>
		</button>
	)}
</section>



<!-- 技術スキル -->
<section class="section" id="skills">
	<h2 class="section-title">Tech Stack & Experience</h2>
	<p class="section-subtitle">経験したことのある技術</p>

	<div class="skill-groups">

		<!-- プログラミング -->
		<div class="skill-group">
			<p class="skill-category">Programming</p>
			<div class="tech-tags">
				<span class="tech-tag">Python</span>
				<span class="tech-tag">YAML</span>
			</div>
		</div>

		<!-- OS・インフラ -->
		<div class="skill-group">
			<p class="skill-category">OS & Infrastructure</p>
			<div class="tech-tags">
				<span class="tech-tag">Linux</span>
				<span class="tech-tag">Shell Script</span>
				<span class="tech-tag">Bash</span>
			</div>
		</div>

		<!-- 開発ツール -->
		<div class="skill-group">
			<p class="skill-category">Development Tools</p>
			<div class="tech-tags">
				<span class="tech-tag">Git</span>
				<span class="tech-tag">GitHub</span>
				<span class="tech-tag">VS Code</span>
			</div>
		</div>

		<!-- Web開発 -->
		<div class="skill-group">
			<p class="skill-category">Web Development</p>
			<div class="tech-tags">
				<span class="tech-tag">Astro</span>
				<span class="tech-tag">HTML / CSS</span>
			</div>
		</div>

		<!-- 学習中 -->
		<div class="skill-group">
			<p class="skill-category">Currently Learning</p>
			<div class="tech-tags">
				<span class="tech-tag">Docker</span>
				<span class="tech-tag">Ansible</span>
				<span class="tech-tag">Infrastructure</span>
			</div>
		</div>

	</div>
</section>

		</main>

		<Footer />
	</body>
</html>

<script>
	document.querySelectorAll<HTMLButtonElement>('.show-more-button').forEach((button) => {
		button.addEventListener('click', () => {
			const section = button.closest('section');
			if (!section) return;

			const expanded = button.getAttribute('aria-expanded') !== 'true';
			section.querySelectorAll('.tile-hidden').forEach((tile) => {
				tile.classList.toggle('is-visible', expanded);
			});
			button.setAttribute('aria-expanded', String(expanded));
			button.querySelector('span')!.textContent = expanded ? '閉じる' : 'もっと見る';
		});
	});
</script>

<style>
	.tile-hidden { display: none; }
	.tile-hidden.is-visible { display: block; }
	.qualification-item.tile-hidden.is-visible { display: flex; }
	.show-more-button {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin: 22px auto 0;
		padding: 10px 18px;
		color: #72f1ff;
		background: rgba(34, 38, 49, .92);
		border: 1px solid #333;
		border-radius: 8px;
		font: inherit;
		cursor: pointer;
		transition: border-color .2s, color .2s;
	}
	.show-more-button:hover { border-color: #72f1ff; color: #fff; }
	.show-more-arrow { font-size: .7em; transition: transform .2s; }
	.show-more-button[aria-expanded="true"] .show-more-arrow { transform: rotate(180deg); }
</style>
